# PolicyProof Unified MCP Server Environment Configuration

# Gnani API Keys (Leave blank or set with valid keys)
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=

# Server Binding Configuration
HOST=0.0.0.0
PORT=8000

# Security / Host Filtering (Leave blank or '*' to allow all, or specify comma-separated domains)
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
